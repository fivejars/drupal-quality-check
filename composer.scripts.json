{
  "scripts": {
    "grumphp": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/grumphp run"
    ],
    "phpmetrics": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/phpmetrics --composer=false --report-html=/var/www/web/report/phpmetrics web/modules/custom"
    ],
    "phpstan": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/phpstan analyse"
    ],
    "phpcs": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/phpcs --runtime-set testVersion 8.4"
    ],
    "phpcbf": "vendor/bin/phpcbf",
    "phpmd": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/phpmd analyze web/modules/custom/ --format text --ruleset phpmd.xml --no-progress",
      "vendor/bin/phpmd analyze web/themes/custom/ --format text --ruleset phpmd.xml --no-progress"
    ],
    "phpmnd": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/phpmnd web/modules/custom --progress"
    ],
    "twigcs": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/twigcs"
    ]
  }
}
